    function fetchDatesFromSharePointList() {
        // Specify your SharePoint site URL
        SP.SOD.executeFunc('sp.js', 'SP.ClientContext', function () {
            var context = SP.ClientContext.get_current();
            var web = context.get_web();
            var webUrl = _spPageContextInfo.webAbsoluteUrl;
            // Specify the name of your SharePoint list

            var endpointUrl = webUrl + "/_api/web/lists/getbytitle('HolidayCalendar')/items?$select=HolidayDate";

            // SharePoint REST API endpoint for retrieving items from the list


            // Make the REST API call
            $j.ajax({
                url: endpointUrl,
                method: 'GET',
                headers: {
                    'Accept': 'application/json;odata=nometadata'
                },
                success: function (data) {
                    // Process the retrieved data and populate the highlightedDates array
                    data.value.forEach(function (item) {
                        var dateValue = item.HolidayDate;
                        var modifiedDate = addOneDayToDate(dateValue);
                        var localDate = new Date(modifiedDate);
                        var finaldate = localDate.toISOString().split('T')[0];
                        //var finaldate = dateValue.toString().split('T')[0];

                        // Change 'DateField' to the actual field name in your SharePoint list
                        // alert(finaldate);
                        highlightedDates.push(finaldate);

                    });

                    console.log('Highlighted Dates from SharePoint List:', highlightedDates);
                },
                error: function (error) {
                    console.log('Error fetching data from SharePoint:', error);
                }
            });
        });
    }

    function addOneDayToDate(inputDate) {
        // Create a new Date object based on the inputDate
        var dateObject = new Date(inputDate);

        // Add one day to the date
        dateObject.setDate(dateObject.getDate() + 1);//+1

        // Return the modified date
        return dateObject;
    }


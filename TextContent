$MagnitudeFolder = Join-Path $env:TEMP "CET-Magnitude-Inspect"


New-Item -ItemType Directory -Force -Path $MagnitudeFolder | Out-Null
curl.exe --negotiate --user ":" --location --connect-timeout 20 --max-time 60 --output "$MagnitudeFolder\magnitude.html" --write-out "HTTP %{http_code}" "https://connectmagnitude.dib.ae/sites/IT/Timesheet/Pages/Home.aspx"
$MagnitudeHtml = Get-Content -LiteralPath "$MagnitudeFolder\magnitude.html" -Raw
[regex]::Matches($MagnitudeHtml, '(?is)<(?:input|select|textarea)\b[^>]*>') | ForEach-Object { $_.Value } | Where-Object { $_ -match 'date|calendar' } | ForEach-Object { [regex]::Matches($_, '(?i)\b(id|name|type|class)="[^"]*"') | ForEach-Object { $_.Value } }


Invoke-WebRequest -UseDefaultCredentials -UseBasicParsing -Uri "https://connectmagnitude.dib.ae/sites/IT/Timesheet/Pages/Home.aspx" -OutFile "$MagnitudeFolder\magnitude.html"

[regex]::Matches($MagnitudeHtml, '(?is)<script\b[^>]*\bsrc="([^"]+)"') | ForEach-Object { $_.Groups[1].Value }
[regex]::Matches($MagnitudeHtml, '(?is)<script\b[^>]*>(.*?)</script>') | ForEach-Object { [regex]::Matches($_.Groups[1].Value, '(?is).{0,120}(?:txtdate|hdn_Sec_TimesheetDate|GetUrlKeyValue|URLSearchParams|location\.search|querystring).{0,220}') | ForEach-Object { $_.Value } }

[regex]::Matches((Get-Content -LiteralPath "$env:TEMP\CET-Magnitude-Inspect\magnitude.html" -Raw), '(?is)<script\b[^>]*>(.*?)</script>') | ForEach-Object { $_.Groups[1].Value } | Where-Object { $_ -match 'txtdate|fetchDatesFromSharePointList|GetUrlKeyValue|URLSearchParams|location\.search|querystring' } | Set-Content -LiteralPath "$env:TEMP\CET-Magnitude-Inspect\Magnitude-Date-Scripts.txt" -Encoding UTF8
notepad.exe "$env:TEMP\CET-Magnitude-Inspect\Magnitude-Date-Scripts.txt"
